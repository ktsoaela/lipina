# Copy to backend/.env for local dev, or set these in your hosting environment.

# --- core -------------------------------------------------------------
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string        # python -c "import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=music.example.com
CSRF_TRUSTED_ORIGINS=https://music.example.com
DATABASE_URL=postgres://lipina:lipina@db:5432/lipina
CACHE_URL=redis://redis:6379/1
SECURE_SSL_REDIRECT=0                 # set 1 if Django terminates TLS itself (usually the proxy does)
USE_X_FORWARDED_HOST=1

# --- media ------------------------------------------------------------
MEDIA_ROOT=/data/media
USE_X_ACCEL_REDIRECT=1                # nginx serves audio bytes (see deploy/nginx.conf)
MAX_UPLOAD_MB=200

# --- accounts ---------------------------------------------------------
OPEN_REGISTRATION=1
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
# Optional: create an admin on first boot
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- integrations -----------------------------------------------------
# Song recognition (Shazam-style). Get a token at https://dashboard.audd.io
AUDD_API_TOKEN=
RADIO_COUNTRY_CODE=ZA

# Streaming services. Each is optional and shows up under "Streaming" once set.
# Spotify (full tracks need Spotify Premium): create an app at https://developer.spotify.com/dashboard,
# tick "Web API" and "Web Playback SDK", and add the redirect URI https://music.example.com/connect/spotify
SPOTIFY_CLIENT_ID=
# YouTube Music: a YouTube Data API v3 key from https://console.cloud.google.com (restrict it to that API)
YOUTUBE_API_KEY=
YOUTUBE_REGION=ZA
# Apple Music full tracks (MusicKit, needs an Apple Developer account and a Media Services .p8 key).
# iTunes 30-second previews work without any of this.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_FILE=
ITUNES_COUNTRY=za
PODCAST_COUNTRY=za
HTTP_USER_AGENT=Lipina/1.0 (+https://music.example.com)

# Comma-separated origins allowed to call the API from other web apps (the Flutter app doesn't need this)
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
